# Copy to .env and adjust. Every variable is optional: without any of them the system runs fully
# offline, on the synthetic market, with the LLM in simulated mode.
# Never commit .env. Values here are placeholders only.

# --- Runtime -----------------------------------------------------------------------------
# Directory for the ledger, checkpoints, caches and reports.
# Default: <repository>/data in a source checkout, ~/.qmas/data when installed. Docker uses /data.
QMAS_DATA_DIR=

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL. Default: INFO.
QMAS_LOG_LEVEL=INFO

# Base random seed for reproducible runs. Default: 20260929.
QMAS_SEED=20260929

# --- LLM agents (reporter now; red-team proposals later) ---------------------------------
# Who answers LLM calls: simulated | openai | anthropic | xai | openai_compatible.
# Default: simulated (deterministic drafts, no network, no cost).
QMAS_LLM_PROVIDER=simulated

# Model id of the provider. Required for every provider except simulated. Check the provider's
# models endpoint for current ids, for example claude-opus-5-5 or claude-sonnet-5-5 on Anthropic.
QMAS_LLM_MODEL=

# Keys, one per provider; only the one of QMAS_LLM_PROVIDER is read.
# OpenAI (GPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# xAI (Grok), OpenAI-compatible endpoint https://api.x.ai/v1: https://console.x.ai
XAI_API_KEY=
# Any other OpenAI-compatible endpoint (OpenRouter, OpenCode Zen, a local server):
# set QMAS_LLM_PROVIDER=openai_compatible, the base URL and its key.
QMAS_LLM_BASE_URL=
QMAS_LLM_API_KEY=

# Limits. Prices are USD per million tokens of YOUR model (defaults: Claude Opus 5.5, 4 / 20).
QMAS_LLM_MAX_OUTPUT_TOKENS=2000
QMAS_LLM_TIMEOUT_SECONDS=60
QMAS_LLM_CACHE=true
QMAS_LLM_INPUT_USD_PER_MTOK=4.0
QMAS_LLM_OUTPUT_USD_PER_MTOK=20.0
# Spending caps (RULE-BUDGET-01): past them the client answers in simulated mode. Also set a limit
# at the provider: these caps only see what this program spends.
QMAS_LLM_RUN_BUDGET_USD=0.50
QMAS_LLM_MONTHLY_BUDGET_USD=20.0

# --- Market data (planned; v0.1 does not read these, it uses the synthetic market) --------
# Primary: Alpaca Market Data API. Basic plan is free (IEX real time, history since 2016 except the
# latest 15 minutes, 200 calls/min); Algo Trader Plus (USD 99/month) adds all US exchanges (SIP).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex (free plan) | sip (Algo Trader Plus)
ALPACA_DATA_FEED=iex
# Free sources for what Alpaca does not cover (see the README, "Data sources"):
# SEC EDGAR (fundamentals, insiders, 13F) asks every client for a User-Agent with a contact address.
EDGAR_USER_AGENT=

# --- Development --------------------------------------------------------------------------
# Path to a private denylist used by `poe repo-check` (one string per line). Keep the file
# OUTSIDE the repository. Leave empty to skip the denylist step.
QMAS_DENYLIST_FILE=
